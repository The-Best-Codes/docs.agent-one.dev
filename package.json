{
  "name": "docs.agent-one.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint:docs": "bun run lint:docs:markdown && bun run lint:docs:links && bun run lint:docs:spelling",
    "lint:docs:markdown": "markdownlint-cli2 \"content/docs/**/*.mdx\"",
    "lint:docs:links": "lychee \"content/docs/**/*.mdx\"",
    "lint:docs:spelling": "cspell \"content/docs/**/*.mdx\"",
    "format": "prettier --write .",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.3",
    "@radix-ui/react-popover": "^1.1.23",
    "@takumi-rs/image-response": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cspell": "^10.1.1",
    "markdownlint-cli2": "^0.23.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
