{
  "name": "docs.agent-one.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "postbuild": "next-sitemap",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint:docs": "bun run lint:docs:markdown && bun run lint:docs:links && bun run lint:docs:spelling",
    "lint:docs:markdown": "markdownlint-cli2 \"content/docs/**/*.mdx\"",
    "lint:docs:links": "lychee \"content/docs/**/*.mdx\"",
    "lint:docs:spelling": "cspell \"content/docs/**/*.mdx\"",
    "format": "prettier --write .",
    "postinstall": "fumadocs-mdx",
    "screenshots:serve": "node scripts/screenshots/serve-app.mjs",
    "screenshots": "node scripts/screenshots/capture.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.5",
    "@radix-ui/react-popover": "^1.3.1",
    "@takumi-rs/image-response": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "next-sitemap": "^4.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cspell": "^10.4.0",
    "markdownlint-cli2": "^0.24.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
