{
  "name": "docs.agent-one.dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "lint:docs": "bun run lint:docs:markdown && bun run lint:docs:links && bun run lint:docs:spelling",
    "lint:docs:markdown": "markdownlint-cli2 \"content/docs/**/*.mdx\"",
    "lint:docs:links": "lychee \"content/docs/**/*.mdx\"",
    "lint:docs:spelling": "cspell \"content/docs/**/*.mdx\"",
    "format": "prettier --write .",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@next/third-parties": "^16.4.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@takumi-rs/image-response": "^2.14.0",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "16.16.2",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cspell": "^10.3.6",
    "markdownlint-cli2": "^0.23.3",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
